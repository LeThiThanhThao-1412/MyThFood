# ============================================================================
# MyThFood Environment Variables - TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to git - it is already in .gitignore
# ============================================================================

# Node Environment
NODE_ENV=development

# ============================================================================
# Database - PostgreSQL
# ============================================================================
DB_USER=mythfood
DB_PASSWORD=change_me_to_secure_password
DB_NAME=mythfood_identity
DB_NAME_IDENTITY=mythfood_identity
DB_NAME_CONSUMER=mythfood_consumer
DB_NAME_MERCHANT=mythfood_merchant
DB_NAME_ORDER=mythfood_order
DB_NAME_INVENTORY=mythfood_inventory
DB_NAME_PAYMENT=mythfood_payment
DB_NAME_DRIVER=mythfood_driver
DB_NAME_DISPATCH=mythfood_dispatch
DB_NAME_WALLET=mythfood_wallet

# ============================================================================
# Redis
# ============================================================================
REDIS_PASSWORD=change_me_redis_secret
# URL đầy đủ cho service dùng Redis (order-service, driver-service GPS GEO cache...)
# Local (không mật khẩu): redis://localhost:6379
REDIS_URL=redis://default:change_me_redis_secret@localhost:6379

# ============================================================================
# GPS realtime (driver-service)
# ============================================================================
# TTL (giây) của vị trí "nóng" trong Redis GEO. Quá hạn → tài xế rời tập matching
# realtime (vẫn còn trong DB). Nên >= 3 lần nhịp tim của app (idle 15s).
DRIVER_GEO_TTL_SECONDS=90
# Không nhận GPS trong bao nhiêu giây thì tự chuyển tài xế sang OFFLINE.
# Phải lớn hơn nhịp tim tối đa của client (idle: 15s).
DRIVER_OFFLINE_TIMEOUT_SECONDS=20
# Namespace `/tracking` của driver-service cho app tài xế / app khách.
NEXT_PUBLIC_DRIVER_WS_URL=http://localhost:3007/tracking
# Bật bảng "Giả lập GPS" (demo tài xế chạy theo lộ trình) cả trên bản build
# production. Ở chế độ dev panel luôn bật; chỉ hiện với role DRIVER.
NEXT_PUBLIC_GPS_SIMULATOR=0

# ============================================================================
# JWT Secrets - Generate unique 256-bit secrets per service
# Use: openssl rand -hex 32
# ============================================================================
JWT_SECRET_IDENTITY=generate_a_random_secret_here
JWT_REFRESH_SECRET_IDENTITY=generate_another_random_secret_here
JWT_REFRESH_EXPIRATION=7d

JWT_SECRET_CONSUMER=generate_a_random_secret_here
JWT_SECRET_MERCHANT=generate_a_random_secret_here
JWT_SECRET_ORDER=generate_a_random_secret_here
JWT_SECRET_INVENTORY=generate_a_random_secret_here
JWT_SECRET_PAYMENT=generate_a_random_secret_here
JWT_SECRET_DRIVER=generate_a_random_secret_here
JWT_SECRET_DISPATCH=generate_a_random_secret_here
JWT_SECRET_WALLET=generate_a_random_secret_here
JWT_SECRET_UPLOAD=generate_a_random_secret_here

# ============================================================================
# Stripe - NEVER commit real keys here! Use Stripe test keys for dev.
# Get them from: https://dashboard.stripe.com/test/apikeys
# ============================================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_API_VERSION=2023-10-16

# ============================================================================
# Wallet - Thu hồi nợ clawback tự động ("ví đủ tiền là trừ ngay")
# DEBT_RECOVERY_MODE: FULL_WHEN_COVERED | PARTIAL_ALWAYS | OFF
# ============================================================================
DEBT_RECOVERY_MODE=FULL_WHEN_COVERED
DEBT_RECOVERY_SWEEP_ENABLED=true

# ============================================================================
# CORS - Comma-separated list of allowed origins
# ============================================================================
CORS_ORIGIN=http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004
# ============================================================================
# Service API Key (internal cross-service auth)
# ============================================================================
SERVICE_API_KEY=change_me_service_api_key

# Database names for newer services
DB_NAME_PROMOTION=mythfood_promotion
DB_NAME_NOTIFICATION=mythfood_notification
DB_NAME_REVIEW=mythfood_review
DB_NAME_RESOLUTION=mythfood_resolution
DB_NAME_CHAT=mythfood_chat

# JWT secrets for newer services (IMPORTANT: must match JWT_SECRET_IDENTITY)
JWT_SECRET_PROMOTION=generate_a_random_secret_here
JWT_SECRET_NOTIFICATION=generate_a_random_secret_here
JWT_SECRET_REVIEW=generate_a_random_secret_here
JWT_SECRET_RESOLUTION=generate_a_random_secret_here
JWT_SECRET_CHAT=generate_a_random_secret_here

# Upload storage (S3 optional; local is default)
STORAGE_DRIVER=local
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Stripe publishable key (frontend - put in consumer-app/.env.local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ============================================================================
# AI Assistant (Gemini) - resolution-service
# Lấy key tại https://aistudio.google.com/apikey — CHỈ để trong .env, không commit
# ============================================================================
AI_ASSISTANT_ENABLED=false
# ============================================================================
# AI Assistant — ngữ cảnh & ẩn danh PII
# ============================================================================
# Ẩn danh trước khi gửi model: off | shadow | enforce
AI_PII_MODE=enforce
AI_PII_HMAC_SECRET=change_me_pii_hmac_secret
# Bật/tắt từng nguồn dữ liệu mở rộng (D15–D19)
AI_CONTEXT_MENU=true
AI_CONTEXT_PROMO=true
AI_CONTEXT_MERCHANT_REVIEWS=true
AI_CONTEXT_DRIVER_REVIEWS=true
AI_CONTEXT_DRIVER_PROFILE=true
AI_CONTEXT_MAX_MENU_ITEMS=10
AI_CONTEXT_MAX_REVIEWS=5
AI_CONTEXT_MAX_PROMOTIONS=10
# Ảnh chuẩn món đính kèm cho vision (0 = tắt); tổng ảnh ≤ 8 tuỳ model
# Lưu ý: `.env` cục bộ cũng phải đặt AI_ASSISTANT_MAX_IMAGES=6; nếu để 4,
# ảnh món thường bị 0 suất khi đã có ảnh giao hàng + ảnh hai bên.
AI_MAX_MENU_IMAGES=2
AI_ASSISTANT_MAX_IMAGES=6
# Bỏ qua ảnh tải về lớn hơn giới hạn này (byte) — model không nhận nổi ảnh quá lớn
AI_MAX_IMAGE_BYTES=5242880
# Tải ảnh bằng chứng: thử lại khi DNS/timeout (EAI_AGAIN) và cache trong 10 phút
# để lượt "Phân tích lại" không mất ảnh vì upload-service/S3 chập chờn.
AI_IMAGE_DOWNLOAD_ATTEMPTS=3
AI_IMAGE_CACHE_TTL_MS=600000
AI_IMAGE_CACHE_MAX=12
# Ngân sách ký tự ngữ cảnh trước khi bỏ bớt nguồn ưu tiên thấp
AI_PROMPT_CHAR_BUDGET=48000
# Tầng phân tích chi tiết (sourceAssessment/detailedFindings/contradictions…)
AI_DEEP_OUTPUT=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=1500
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# --- Nhà cung cấp LLM: glm (Zhipu) hoặc gemini (Google) ---
AI_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash
# Model đọc ảnh bằng chứng (GLM tách model chữ / model vision). Đặt "none" để bỏ phần ảnh.
GLM_VISION_MODEL=glm-4.6v-flash
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_TIMEOUT_MS=120000
GLM_MAX_ATTEMPTS=3
GLM_RETRY_BASE_MS=1500
# Model vision dự phòng khi model free quá tải (429/1302/1305).
# Không đặt = glm-4.6v-flashx,glm-4.5v; "none" = chỉ dùng GLM_VISION_MODEL.
GLM_VISION_FALLBACK_MODELS=glm-4.6v-flashx,glm-4.5v
# Quá tải model: chờ 8s, thử thêm 2 lần (tổng ~16s) trước khi bỏ ảnh.
GLM_OVERLOAD_RETRY_MS=8000
GLM_OVERLOAD_ATTEMPTS=2
GLM_FALLBACK_MODELS=none
GLM_THINKING=auto

# Tự động cho AI phân tích ngay khi có khiếu nại mới (admin chỉ đọc & duyệt)
AI_AUTO_ANALYZE=true

# ============================================================================
# Phương thức giao hàng (SAVER / FAST / PRIORITY) - Phase 1
# ============================================================================
# Hệ số giá so với phí giao hàng tiêu chuẩn (FAST)
SAVER_FEE_FACTOR=0.8
PRIORITY_FEE_FACTOR=1.3
PRIORITY_SURCHARGE=10000
PRIORITY_MAX_FEE=120000
# Thời gian chờ tài xế nhận đơn (giây)
SAVER_DISPATCH_TIMEOUT_SECONDS=600
PRIORITY_DISPATCH_TIMEOUT_SECONDS=180
# Thời gian chờ tài xế phản hồi sau khi được gán đơn (giây)
PRIORITY_DRIVER_RESPONSE_TIMEOUT_SECONDS=30
SAVER_DRIVER_RESPONSE_TIMEOUT_SECONDS=90
# Bán kính lệch tuyến tối đa của ĐIỂM GIAO khi gộp đơn SAVER (km)
SAVER_STACK_RADIUS_KM=3
# Bán kính tối đa của QUÁN mới so với quán hiện có (km)
SAVER_PICKUP_RADIUS_KM=3
# Tổng quãng đường tối ưu được phép tăng thêm khi gộp thêm 1 đơn (km)
SAVER_MAX_DETOUR_KM=3
# Bán kính tối đa từ GPS hiện tại của tài xế tới QUÁN để được nhận đơn (km).
# Áp dụng cho danh sách đơn khả dụng, PATCH /dispatches/:id/driver-accept
# và bán kính mặc định của GET /dispatches/nearby.
DISPATCH_MAX_RADIUS_KM=5
