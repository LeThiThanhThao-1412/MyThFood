# ============================================================================
# MyThFood Environment Variables - TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to git - it is already in .gitignore
# ============================================================================

# Node Environment
NODE_ENV=development

# ============================================================================
# Database - PostgreSQL
# ============================================================================
DB_USER=mythfood
DB_PASSWORD=change_me_to_secure_password
DB_NAME=mythfood_identity
DB_NAME_IDENTITY=mythfood_identity
DB_NAME_CONSUMER=mythfood_consumer
DB_NAME_MERCHANT=mythfood_merchant
DB_NAME_ORDER=mythfood_order
DB_NAME_INVENTORY=mythfood_inventory
DB_NAME_PAYMENT=mythfood_payment
DB_NAME_DRIVER=mythfood_driver
DB_NAME_DISPATCH=mythfood_dispatch
DB_NAME_WALLET=mythfood_wallet

# ============================================================================
# Redis
# ============================================================================
REDIS_PASSWORD=change_me_redis_secret

# ============================================================================
# JWT Secrets - Generate unique 256-bit secrets per service
# Use: openssl rand -hex 32
# ============================================================================
JWT_SECRET_IDENTITY=generate_a_random_secret_here
JWT_REFRESH_SECRET_IDENTITY=generate_another_random_secret_here
JWT_REFRESH_EXPIRATION=7d

JWT_SECRET_CONSUMER=generate_a_random_secret_here
JWT_SECRET_MERCHANT=generate_a_random_secret_here
JWT_SECRET_ORDER=generate_a_random_secret_here
JWT_SECRET_INVENTORY=generate_a_random_secret_here
JWT_SECRET_PAYMENT=generate_a_random_secret_here
JWT_SECRET_DRIVER=generate_a_random_secret_here
JWT_SECRET_DISPATCH=generate_a_random_secret_here
JWT_SECRET_WALLET=generate_a_random_secret_here
JWT_SECRET_UPLOAD=generate_a_random_secret_here

# ============================================================================
# Stripe - NEVER commit real keys here! Use Stripe test keys for dev.
# Get them from: https://dashboard.stripe.com/test/apikeys
# ============================================================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_API_VERSION=2023-10-16

# ============================================================================
# CORS - Comma-separated list of allowed origins
# ============================================================================
CORS_ORIGIN=http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004
# ============================================================================
# Service API Key (internal cross-service auth)
# ============================================================================
SERVICE_API_KEY=change_me_service_api_key

# Database names for newer services
DB_NAME_PROMOTION=mythfood_promotion
DB_NAME_NOTIFICATION=mythfood_notification
DB_NAME_REVIEW=mythfood_review

# JWT secrets for newer services (IMPORTANT: must match JWT_SECRET_IDENTITY)
JWT_SECRET_PROMOTION=generate_a_random_secret_here
JWT_SECRET_NOTIFICATION=generate_a_random_secret_here
JWT_SECRET_REVIEW=generate_a_random_secret_here

# Upload storage (S3 optional; local is default)
STORAGE_DRIVER=local
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Stripe publishable key (frontend - put in consumer-app/.env.local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
