NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mythfood_order
DATABASE_USER=mythfood
DATABASE_PASSWORD=mythfood_secret
JWT_SECRET=mythfood_jwt_super_secret_key_dev_only
JWT_EXPIRATION=1h
PORT=3004
CORS_ORIGIN=*
REDIS_URL=redis://default:mythfood_redis_secret_dev@localhost:6379

# Service-to-service (chạy local ngoài Docker)
CONSUMER_SERVICE_URL=http://localhost:3002
MERCHANT_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3006
DRIVER_SERVICE_URL=http://localhost:3007
DISPATCH_SERVICE_URL=http://localhost:3008
WALLET_SERVICE_URL=http://localhost:3009
PROMOTION_SERVICE_URL=http://localhost:3012
NOTIFICATION_SERVICE_URL=http://localhost:3013
RESOLUTION_SERVICE_URL=http://localhost:3014

# Stripe yêu cầu tối thiểu ~50 cent; chênh lệch nhỏ hơn sẽ trừ vào ví
CARD_ADJUSTMENT_MIN_AMOUNT=13000
