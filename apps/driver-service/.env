NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mythfood_driver
DATABASE_USER=mythfood
DATABASE_PASSWORD=mythfood_secret
JWT_SECRET=mythfood_jwt_super_secret_key_dev_only
JWT_EXPIRATION=1h
PORT=3007
CORS_ORIGIN=*
# Auto-offline: so giay khong nhan duoc vi tri GPS (heartbeat) thi tu chuyen tai xe sang OFFLINE.
# Phai lon hon vai lan chu ky gui vi tri cua driver-app (5 giay).
DRIVER_OFFLINE_TIMEOUT_SECONDS=20
